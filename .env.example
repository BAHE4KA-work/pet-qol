# App & Security
APP_ENV=development
API_BEARER_TOKEN=change-me-to-long-random-bearer-token
ENCRYPTION_KEY=
TIMEZONE=Europe/Moscow
LIFEOS_DOMAIN=localhost

# PostgreSQL 16 + pgvector & Redis
DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@postgres:5432/lifeos
REDIS_URL=redis://redis:6379/0

# Google Gemini API & NVIDIA NIM Fallback
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
DECISION_MODEL=gemini-decision-1
STT_MODEL=gemini-3.5-transcribe
TIER2_MODEL=gemma-4-31b-it
TIER3_MODEL=gemini-4-hydrogen
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=google/gemma-4-31b-it

# Quotas & Goldilocks Controller
HYDROGEN_DAILY_LIMIT=20
HYDROGEN_RESERVED_SYSTEM=3
HIGH_CONFIDENCE_THRESHOLD=0.78
MEDIUM_CONFIDENCE_THRESHOLD=0.45
BASE_DAILY_CAPACITY=20.0
GOLDILOCKS_LOW=0.75
GOLDILOCKS_HIGH=0.85
DEFERRAL_SPLIT_THRESHOLD=3

# Notion (5 linked databases)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_GOALS_DB_ID=
NOTION_PROJECTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_TELEMETRY_DB_ID=
NOTION_INSIGHTS_DB_ID=

# Apple iCloud CalDAV (Events only)
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USERNAME=
CALDAV_APP_PASSWORD=
CALDAV_CALENDAR_NAME=LifeOS

# Telegram Bot (Bot API 10.4/10.5 HTML Widgets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=0
TELEGRAM_WIDGET_ENABLED=true

# Telegram Userbot (Strict Read-Only MTProto / Telethon)
TELETHON_API_ID=0
TELETHON_API_HASH=
TELETHON_SESSION_STRING=
TELETHON_WHITELIST_CHAT_IDS=[]
TELETHON_WHITELIST_FOLDERS=[]

# Gmail (Strict Read-Only gmail.readonly)
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=
GMAIL_POLL_QUERY=is:unread newer_than:7d
